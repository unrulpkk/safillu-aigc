# First install: copy to .env.local (Git-ignored), or let start.sh/start.ps1 create it.
# Explanations: README.md -> Configuration and credentials.
# Credential acquisition and private file paths: docs/credentials.md.
# This file contains deployment settings only. Do not add passwords or API keys.

# Choose these identifiers before the first installation; changing them is not a migration.
COMPOSE_PROJECT_NAME=safillu
DB_NAME=safillu
DB_USERNAME=safillu_app

# Host ports and the browser-visible creator origin (scheme + host + optional port).
WEB_PORT=8088
ADMIN_PORT=8089
PUBLIC_ORIGIN=http://localhost:8088

# Persistent private secrets; mounted to /run/secrets inside containers.
SAFILLU_RUNTIME_DIR=./.runtime

# Optional Google sign-in callback. When enabled, match PUBLIC_ORIGIN and Google exactly.
# Empty uses Compose's localhost:8088 callback default.
GOOGLE_REDIRECT_URI=

# R2 auto: prefer configured R2 after a successful upload/read/delete roundtrip.
QINIU_STORAGE_BOOTSTRAP=false
R2_STORAGE_BOOTSTRAP=auto

# Stripe test settings. Public webhook URL may stay empty when payments are not configured.
STRIPE_MODE=TEST
STRIPE_LIVE_ENABLED=false
STRIPE_PUBLIC_WEBHOOK_URL=

# Optional JVM settings; the backend container has a 1200m memory limit.
JAVA_OPTS=-Xms128m -Xmx768m
