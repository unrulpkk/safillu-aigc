# Private configuration: commit reviewed templates, never machine overrides.
.env
.env.*
!.env.example
!.env.prod.example
!.env.local.example
!**/.env.example
!**/.env.prod.example
!**/.env.local.example
# Reviewed, credential-free inputs required by the production builds.
!/zaomeng-admin/.env
!/zaomeng-admin/.env.prod
!/lumina-studio/.env.prod
!/zaomeng-backend/deploy/.env.prod
config.local.*
*.local.properties
*.local.json
*.local.yaml
*.local.yml
application-local.yaml
application-local.yml
application-dev.yaml
application-dev.yml
application-my.yaml
application-my.yml
application-*.local.yaml
application-*.local.yml
maven-settings.xml
settings.xml
http-client.env.json
http-client.private.env.json
compose.override.yaml
compose.override.yml
docker-compose.override.yaml
docker-compose.override.yml

