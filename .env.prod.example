# First install: copy to .env.prod.local; keep private overrides outside Git.
# See README.md for every variable and docs/credentials.md for all credentials.
# Replace YOUR_CREATOR_DOMAIN. Do not add passwords or API keys here.
COMPOSE_PROJECT_NAME=safillu
DB_NAME=safillu
DB_USERNAME=safillu_app
WEB_PORT=8088
ADMIN_PORT=8089
PUBLIC_ORIGIN=https://YOUR_CREATOR_DOMAIN
# Must match the OAuth client's registered callback when Google sign-in is enabled.
GOOGLE_REDIRECT_URI=https://YOUR_CREATOR_DOMAIN/app-api/member/auth/google-login
# Must be publicly reachable for Stripe event delivery.
STRIPE_PUBLIC_WEBHOOK_URL=https://YOUR_CREATOR_DOMAIN/admin-api/aigc/payments/stripe/webhook
SAFILLU_RUNTIME_DIR=./.runtime
QINIU_STORAGE_BOOTSTRAP=false
R2_STORAGE_BOOTSTRAP=auto
# Production deployment does not automatically enable live payments.
STRIPE_MODE=TEST
STRIPE_LIVE_ENABLED=false
JAVA_OPTS=-Xms128m -Xmx768m
